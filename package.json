{
  "name": "marathonhub-api",
  "version": "1.0.0",
  "description": "API REST para la gestion integral de carreras, maratones y eventos deportivos (MarathonHub)",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node src/seeders/run.js",
    "seed:demo": "node src/seeders/run.js --demo",
    "db:sync": "node src/scripts/sync.js",
    "test": "node --test --test-concurrency=1",
    "check": "node --check server.js"
  },
  "keywords": [
    "marathon",
    "running",
    "express",
    "sequelize",
    "mysql",
    "swagger",
    "jwt",
    "rbac"
  ],
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "mysql2": "^3.15.3",
    "sequelize": "^6.37.7",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "sqlite3": "^5.1.7",
    "supertest": "^7.1.4"
  }
}
