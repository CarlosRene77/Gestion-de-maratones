# Copie este archivo como .env y ajuste los valores.
NODE_ENV=development
PORT=3000

DB_DIALECT=mysql
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=1234
DB_NAME=db_maraton_hub
DB_PORT=3306
DB_LOGGING=false
DB_SYNC=true

JWT_SECRET=cambie_esta_clave_en_produccion
JWT_EXPIRES_IN=24h
BCRYPT_SALT_ROUNDS=10

CORS_ORIGIN=*
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30000
AUTH_RATE_LIMIT_MAX=20

ADMIN_NOMBRE=Administrador
ADMIN_APELLIDO=MarathonHub
ADMIN_EMAIL=admin@marathonhub.com
ADMIN_PASSWORD=Admin123!
